# Copy to .env and fill in values. Never commit .env.

# Local PostgreSQL (docker compose reads these too)
POSTGRES_USER=movie_memory
POSTGRES_PASSWORD=
POSTGRES_DB=movie_memory
POSTGRES_PORT=5433

# Must match the values above; replace <password> with POSTGRES_PASSWORD
DATABASE_URL=postgresql://movie_memory:<password>@localhost:5433/movie_memory?schema=public

# Auth.js secret used to sign cookies and tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google OAuth "Web application" client (Google Cloud Console > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed when running a production build locally (`npm run start`).
# AUTH_TRUST_HOST=true

# OpenAI API key (server-side only)
OPENAI_API_KEY=

# Optional: model for movie facts (defaults to gpt-5.4-mini).
# OPENAI_MODEL=gpt-5.4-mini
